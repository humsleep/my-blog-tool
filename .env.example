# =========================================================
# 이 파일은 템플릿입니다. 실제 키는 .env.local 에 입력하세요.
# .env.local 은 git에 커밋되지 않습니다.
# Vercel에는 프로젝트 설정 > Environment Variables 에 입력합니다.
# =========================================================

# --- 필수: 기존 기능 (키워드/경쟁/트렌드/문서수) ---
# 네이버 검색광고 API (https://searchad.naver.com → 도구 → API 사용 관리)
NAVER_SEARCH_AD_API_KEY=
NAVER_SEARCH_AD_SECRET_KEY=
NAVER_SEARCH_AD_CUSTOMER_ID=

# 네이버 개발자센터 오픈 API (https://developers.naver.com/)
# 블로그 검색 + 뉴스 검색에 모두 사용됩니다 (앱 등록 시 '검색' 사용 권한 체크)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 이미지 검색 (선택: 한쪽만 있어도 동작) ---
# Pexels: https://www.pexels.com/api/  (200 req/hr, 20,000 req/월)
PEXELS_API_KEY=

# Unsplash: https://unsplash.com/developers  (Demo 50 req/hr)
UNSPLASH_ACCESS_KEY=

# --- 로그인 (Supabase) ---
# https://supabase.com 에서 프로젝트 생성 후 Settings > API 에서 복사
# Authentication > Providers 에서 Google 활성화 (Google Cloud OAuth Client ID 필요)
# NEXT_PUBLIC_ 접두사는 브라우저에 노출되는 값이므로 anon key만 허용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 비로그인 사용자 일일 한도 추적 (Supabase service role) ---
# Supabase Dashboard > Project Settings > API > service_role secret
# ⚠️ 절대 클라이언트에 노출하지 말 것 (RLS 우회 권한)
# anon_draft_usage 테이블 INSERT/UPDATE 용도로만 사용됨
SUPABASE_SERVICE_ROLE_KEY=

# IP 해시용 솔트 (32자 이상 랜덤 문자열). 변경 시 기존 비로그인 카운트 무효화됨.
# 생성 예: openssl rand -hex 16
IP_HASH_SALT=

# --- AI 초안 생성 (Claude API) ---
# https://console.anthropic.com 에서 발급 (서버 전용, 브라우저에 노출 금지)
ANTHROPIC_API_KEY=

# --- 인증 불필요 기능 ---
# Wikipedia Pageviews API: 키 불필요
# LanguageTool 공개 API:   키 불필요 (20 req/min)

# --- 개인정보 보호책임자 (PIPA 31조 — /privacy 페이지에 표기) ---
# 정식 출시 시 반드시 설정. 미설정 시 페이지에 "[운영자 실명 미설정]" 자리표시자가 노출됩니다.
# 1인 운영의 경우 운영자 본인 실명, 법인이면 책임자 또는 대표자 실명.
# NEXT_PUBLIC_ 접두사 = 빌드 결과물에 포함되어 누구나 볼 수 있는 정보입니다.
NEXT_PUBLIC_PRIVACY_OFFICER_NAME=

# --- 운영자 본인 블로그 URL (선택) — /about Founder note에 신뢰성 신호로 노출 ---
# 미설정 시 해당 칩만 숨겨지고 나머지 본문은 정상 표시. 공개해도 무방한 주소만 입력.
NEXT_PUBLIC_OPERATOR_BLOG_URL=
