# =========================================================
# 이 파일은 템플릿입니다. 실제 키는 .env.local 에 입력하세요.
# .env.local 은 git에 커밋되지 않습니다.
# =========================================================

# --- 필수: 기존 기능 (키워드/경쟁/트렌드/문서수) ---
# 네이버 검색광고 API (https://searchad.naver.com → 도구 → API 사용 관리)
NAVER_SEARCH_AD_API_KEY=
NAVER_SEARCH_AD_SECRET_KEY=
NAVER_SEARCH_AD_CUSTOMER_ID=

# 네이버 개발자센터 오픈 API (https://developers.naver.com/)
# 블로그 검색 + 뉴스 검색에 모두 사용됩니다 (앱 등록 시 '검색' 사용 권한 체크)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Phase 3: 이미지 검색 (선택: 한쪽만 있어도 동작) ---
# Pexels: https://www.pexels.com/api/  (200 req/hr, 20,000 req/월)
PEXELS_API_KEY=

# Unsplash: https://unsplash.com/developers  (Demo 50 req/hr)
UNSPLASH_ACCESS_KEY=

# --- 인증 불필요 기능 ---
# Wikipedia Pageviews API: 키 불필요
# LanguageTool 공개 API:   키 불필요 (20 req/min)
